# Database & Cache (Docker Compose defaults)
DATABASE_URL="postgresql://backeri:backeri_dev_password@localhost:5432/backeri?schema=public"
REDIS_URL="redis://localhost:6379"

# API Server
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Auth & Webhook Security
JWT_SECRET="backeri-dev-jwt-secret-change-in-production-32chars"
WEBHOOK_SECRET="backeri-dev-webhook-hmac-secret-change-in-prod"
UPLOAD_SIGNING_SECRET="backeri-dev-upload-signing-secret-change-in-prod"

# Providers (sandbox | stripe | razorpay / sandbox | s3)
PAYMENT_PROVIDER="sandbox"
NOTIFICATION_PROVIDER="sandbox"
STORAGE_PROVIDER="sandbox"
PUBLIC_API_URL="http://localhost:4000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_INTERNAL_URL="http://localhost:4000"
